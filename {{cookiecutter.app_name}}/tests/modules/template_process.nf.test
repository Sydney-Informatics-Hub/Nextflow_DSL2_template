nextflow_process {

    name "Test Process generate_report"
    script "modules/template_process.nf"
    process "generate_report"

    test("Test the template process") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of(
                    tuple(
                        record( sample: 'test_sample' ),
                        file('../../../tests/data/vapidkangaroo.fastq.gz')
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
